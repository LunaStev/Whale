module {
  format_version 7
  semantics_version 1
  target "x86_64-whale-linux"
  datalayout { ptr=64, endian=little }
  source_file @s9 "경로/memory.wave"
  original 100 @s9 1 1 1 12
  original 200 @s9 2 1 2 9
  original 300 @s9 3 1 3 12
  source_map instruction @f0 %b0 2 100
  source_map instruction @f0 %b0 5 200
  source_map terminator @f0 %b0 300
  declare @f0 "expired_alias": whale () -> u8, linkage internal
  fn @f0 "expired_alias"() -> u8, entry %b0 {
  %b0 "entry":
    %v0: ptr<u8> = alloca u8, align 1
    %v1: ptr<ptr<u8>> = alloca ptr<u8>, align 8
    store ptr<u8> %v0, ptr<ptr<u8>> %v1, align 8
    %v2: i32 = const i32 0
    %v3: ptr<u8> = gep %v0, %v2
    lifetime_end %v3
    %v4: ptr<u8> = load ptr<u8>, ptr<ptr<u8>> %v1, align 8
    %v5: u8 = load u8, ptr<u8> %v4, align 1
    ret u8 %v5
  }
}
