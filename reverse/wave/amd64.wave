// SPDX-License-Identifier: MPL-2.0
// AMD64 whitelist decoder ABI 1. No allocator, imports, OS calls or source recovery.
// Output is 96 u64 words, committed only after complete successful decoding.
// Status: 0 success, 1 invalid argument/encoding, 2 truncated, 3 unsupported,
// 4 overlong, 5 output capacity, 6 ABI mismatch. All offsets are byte-relative.
struct DecodeState {
    data: ptr<u8>;
    remaining: u64;
    position: u64;
    status: i32;
    output: ptr<u64>;
    rex: u64;
}

fun reverse_read(state: ptr<DecodeState>, count: u64) -> u64 {
    if (state.status != 0) {
        return 0;
    }
    if (count > 15 - state.position) {
        state.status = 4;
        return 0;
    }
    if (count > state.remaining - state.position) {
        state.status = 2;
        return 0;
    }
    var value: u64 = 0;
    var i: u64 = 0;
    while (i < count) {
        value = value | ((state.data[state.position + i] as u64) << (i * 8));
        i += 1;
    }
    state.position += count;
    return value;
}

fun reverse_field(state: ptr<DecodeState>, slot: u64, count: u64) -> u64 {
    state.output[slot] = state.position + 1;
    state.output[slot + 1] = count;
    var value: u64 = reverse_read(state, count);
    state.output[slot + 2] = value;
    return value;
}

fun reverse_signed(value: u64, count: u64) -> u64 {
    if (count == 1) {
        return (value as i8) as i64 as u64;
    }
    if (count == 2) {
        return (value as i16) as i64 as u64;
    }
    if (count == 4) {
        return (value as i32) as i64 as u64;
    }
    return value;
}

fun reverse_register(output: ptr<u64>, operand: u64, width: u64, code: u64,
    rex: u64, register_kind: u64) {
    var at: u64 = 40 + operand * 16;
    output[at] = register_kind;
    output[at + 1] = width;
    output[at + 2] = code;
    if (register_kind == 1 && width == 8 && code >= 4 && code <= 7 && rex == 0) {
        output[at + 2] = code - 4;
        output[at + 3] = 1;
    }
}

fun reverse_rm(state: ptr<DecodeState>, operand: u64, width: u64,
    register_kind: u64, modrm: u64) {
    var mode: u64 = modrm >> 6;
    var rm: u64 = modrm & 7;
    var record_out: ptr<u64> = state.output;
    if (mode == 3) {
        var register_width: u64 = width;
        if (register_kind == 2) {
            register_width = 128;
        }
        reverse_register(record_out, operand, register_width, rm + ((state.rex & 1) << 3), state.rex, register_kind);
        return;
    }
    var at: u64 = 40 + operand * 16;
    record_out[at] = 3;
    record_out[at + 1] = width;
    record_out[at + 4] = 1;
    var displacement_bytes: u64 = 0;
    if (rm == 4) {
        record_out[12] = state.position + 1;
        var sib: u64 = reverse_read(state, 1);
        record_out[13] = sib;
        record_out[at + 4] = (1 as u64) << (sib >> 6);
        var index: u64 = (sib >> 3) & 7;
        if (index != 4 || (state.rex & 2) != 0) {
            record_out[at + 3] = index + ((state.rex & 2) << 2) + 1;
        }
        var base: u64 = sib & 7;
        if (mode == 0 && base == 5) {
            // SIB base=5 in mode0 has no base even with REX.B; disp32 is signed.
            displacement_bytes = 4;
        } else {
            record_out[at + 2] = base + ((state.rex & 1) << 3) + 1;
        }
    } else if (mode == 0 && rm == 5) {
        // RIP-relative is independent of REX.B. Address-size override is unsupported.
        record_out[at + 2] = 17;
        displacement_bytes = 4;
    } else {
        record_out[at + 2] = rm + ((state.rex & 1) << 3) + 1;
    }
    if (mode == 1) {
        displacement_bytes = 1;
    } else if (mode == 2) {
        displacement_bytes = 4;
    }
    if (displacement_bytes != 0) {
        var displacement: u64 = reverse_field(state, 14, displacement_bytes);
        record_out[at + 5] = reverse_signed(displacement, displacement_bytes);
    }
}

fun reverse_decode_body(state: ptr<DecodeState>) -> i32 {
    var record_out: ptr<u64> = state.output;
    var operand16: bool = false;
    var mandatory: u64 = 0;
    var prefixes: u64 = 0;
    var first: u64 = 0;
    while (true) {
        first = reverse_read(state, 1);
        if (state.status != 0) {
            return state.status;
        }
        if (first == 102 || first == 242 || first == 243) {
            // A legacy prefix after a REX invalidates that earlier REX.
            state.rex = 0;
            if (first == 102) {
                operand16 = true;
            } else {
                mandatory = first;
            }
        } else if (first >= 64 && first <= 79) {
            state.rex = first;
        } else if (first == 103 || first == 240 || first == 38 || first == 46
            || first == 54 || first == 62 || first == 100 || first == 101) {
            return 3;
        } else {
            break;
        }
        record_out[24 + prefixes] = first;
        prefixes += 1;
        if (prefixes >= 15) {
            return 4;
        }
    }
    record_out[7] = prefixes;
    record_out[8] = state.position - 1;
    record_out[9] = 1;
    record_out[20] = state.rex;
    var width: u64 = 32;
    if (operand16) {
        width = 16;
    }
    if ((state.rex & 8) != 0) {
        width = 64;
    }
    var format: u64 = 0;
    var opcode: u64 = 0;
    var source_width: u64 = width;
    var immediate_bytes: u64 = 0;
    var sign_extended: u64 = 0;
    var group: u64 = 0;
    var shift_kind: u64 = 0;
    var sse: bool = false;
    var condition: u64 = 16;
    var flow: u64 = 0;
    var opcode_register: u64 = first & 7;
    if (first <= 59 && (first & 7) <= 3) {
        var operations: array<u64, 8> = [2, 3, 4, 5, 6, 7, 8, 9];
        opcode = operations[first >> 3];
        if ((first & 1) == 0) {
            width = 8;
        }
        format = 1;
        if ((first & 2) != 0) {
            format = 2;
        }
    } else if (first >= 136 && first <= 139) {
        opcode = 1;
        format = 1;
        if ((first & 1) == 0) {
            width = 8;
        }
        if ((first & 2) != 0) {
            format = 2;
        }
    } else if (first == 128 || first == 129 || first == 131) {
        format = 3;
        group = 1;
        if (first == 128) {
            width = 8;
        }
        immediate_bytes = 1;
        if (first == 129) {
            immediate_bytes = 4;
            if (width == 16) {
                immediate_bytes = 2;
            }
        }
        if ((first == 131 && width > 8) || width == 64) {
            sign_extended = 1;
        }
    } else if (first == 198 || first == 199) {
        opcode = 1;
        format = 3;
        group = 2;
        if (first == 198) {
            width = 8;
        }
        immediate_bytes = width / 8;
        if (width == 64) {
            immediate_bytes = 4;
            sign_extended = 1;
        }
    } else if (first >= 176 && first <= 191) {
        opcode = 1;
        format = 4;
        if (first < 184) {
            width = 8;
        }
        immediate_bytes = width / 8;
    } else if (first >= 80 && first <= 95) {
        opcode = 11;
        if (first >= 88) {
            opcode = 12;
        }
        width = 64;
        if (operand16 && (state.rex & 8) == 0) {
            width = 16;
        }
        format = 6;
    } else if (first == 104 || first == 106) {
        opcode = 11;
        format = 13;
        width = 64;
        immediate_bytes = 4;
        if (operand16 && (state.rex & 8) == 0) {
            width = 16;
            immediate_bytes = 2;
        }
        if (first == 106) {
            immediate_bytes = 1;
        }
        if (immediate_bytes * 8 < width) {
            sign_extended = 1;
        }
    } else if (first == 232 || first == 233 || first == 235 || first == 226
        || (first >= 112 && first <= 127)) {
        opcode = 13;
        flow = 3;
        format = 5;
        immediate_bytes = 1;
        if (first == 232 || first == 233) {
            immediate_bytes = 4;
        }
        if (first == 232) {
            opcode = 16;
            flow = 1;
        } else if (first == 226) {
            opcode = 15;
            flow = 6;
        } else if (first >= 112 && first <= 127) {
            opcode = 14;
            condition = first & 15;
            flow = 5;
        }
    } else if (first == 195) {
        opcode = 17;
        flow = 7;
    } else if (first == 144) {
        if ((state.rex & 1) != 0) {
            return 3;
        }
        opcode = 18;
    } else if (first == 204) {
        opcode = 20;
        flow = 8;
    } else if (first == 153) {
        opcode = 31;
        if (width == 16) {
            opcode = 30;
        } else if (width == 64) {
            opcode = 32;
        }
    } else if (first == 141) {
        opcode = 21;
        format = 2;
    } else if (first == 132 || first == 133) {
        opcode = 22;
        format = 1;
        if (first == 132) {
            width = 8;
        }
    } else if (first == 246 || first == 247) {
        format = 7;
        group = 3;
        if (first == 246) {
            width = 8;
        }
    } else if (first == 192 || first == 193 || (first >= 208 && first <= 211)) {
        format = 8;
        group = 4;
        if ((first & 1) == 0) {
            width = 8;
        }
        if (first == 192 || first == 193) {
            shift_kind = 1;
            immediate_bytes = 1;
        } else if (first == 210 || first == 211) {
            shift_kind = 2;
        }
    } else if (first == 105 || first == 107) {
        opcode = 10;
        format = 9;
        immediate_bytes = 4;
        if (width == 16) {
            immediate_bytes = 2;
        }
        if (first == 107) {
            immediate_bytes = 1;
        }
        if (immediate_bytes * 8 < width) {
            sign_extended = 1;
        }
    } else if (first == 99) {
        if (width != 64) {
            return 3;
        }
        opcode = 35;
        format = 12;
        source_width = 32;
    } else if (first == 255) {
        format = 7;
        group = 5;
        width = 64;
        if (operand16) {
            return 3;
        }
    } else if (first == 15) {
        var second: u64 = reverse_read(state, 1);
        if (state.status != 0) {
            return state.status;
        }
        record_out[9] = 2;
        if (second == 5) {
            opcode = 19;
            flow = 9;
        } else if (second >= 128 && second <= 143) {
            opcode = 14;
            condition = second & 15;
            flow = 5;
            format = 5;
            immediate_bytes = 4;
        } else if (second >= 144 && second <= 159) {
            opcode = 36;
            condition = second & 15;
            width = 8;
            format = 14;
        } else if (second >= 64 && second <= 79) {
            opcode = 37;
            condition = second & 15;
            format = 2;
        } else if (second == 175) {
            opcode = 10;
            format = 2;
        } else if (second == 182 || second == 183 || second == 190 || second == 191) {
            opcode = 33;
            if (second >= 190) {
                opcode = 34;
            }
            source_width = 8;
            if ((second & 1) != 0) {
                source_width = 16;
            }
            if (width <= source_width) {
                return 3;
            }
            format = 12;
        } else if (second == 16 || second == 17 || second == 88 || second == 89
            || second == 92 || second == 94) {
            if ((mandatory != 242 && mandatory != 243) || operand16) {
                return 3;
            }
            sse = true;
            var precision: u64 = 0;
            width = 32;
            if (mandatory == 242) {
                precision = 1;
                width = 64;
            }
            opcode = 38 + precision;
            if (second == 88) {
                opcode = 40 + precision;
            } else if (second == 92) {
                opcode = 42 + precision;
            } else if (second == 89) {
                opcode = 44 + precision;
            } else if (second == 94) {
                opcode = 46 + precision;
            }
            format = 10;
            if (second == 17) {
                format = 11;
            }
        } else {
            return 3;
        }
    } else {
        return 3;
    }
    if (mandatory != 0 && !sse) {
        return 3;
    }
    var modrm: u64 = 0;
    if (format == 1 || format == 2 || format == 3 || format == 7 || format == 8
        || format == 9 || format == 10 || format == 11 || format == 12 || format == 14) {
        record_out[10] = state.position + 1;
        modrm = reverse_read(state, 1);
        if (state.status != 0) {
            return state.status;
        }
        record_out[11] = modrm;
        var extension: u64 = (modrm >> 3) & 7;
        if (group == 1) {
            var operations: array<u64, 8> = [2, 3, 4, 5, 6, 7, 8, 9];
            opcode = operations[extension];
        } else if (group == 2) {
            if (extension != 0) {
                return 3;
            }
        } else if (group == 3) {
            if (extension == 2) {
                opcode = 23;
            } else if (extension == 3) {
                opcode = 24;
            } else if (extension == 6) {
                opcode = 25;
            } else if (extension == 7) {
                opcode = 26;
            } else {
                return 3;
            }
        } else if (group == 4) {
            if (extension == 4) {
                opcode = 27;
            } else if (extension == 5) {
                opcode = 28;
            } else if (extension == 7) {
                opcode = 29;
            } else {
                return 3;
            }
        } else if (group == 5) {
            if (extension == 2) {
                opcode = 16;
                flow = 2;
            } else if (extension == 4) {
                opcode = 13;
                flow = 4;
            } else {
                return 3;
            }
        }
        if (opcode == 21 && modrm >= 192) {
            return 1;
        }
    }
    var register_code: u64 = ((modrm >> 3) & 7) + ((state.rex & 4) << 1);
    if (format == 1) {
        reverse_rm(state, 0, width, 1, modrm);
        reverse_register(record_out, 1, width, register_code, state.rex, 1);
        record_out[5] = 2;
    } else if (format == 2) {
        reverse_register(record_out, 0, width, register_code, state.rex, 1);
        reverse_rm(state, 1, width, 1, modrm);
        record_out[5] = 2;
    } else if (format == 3) {
        reverse_rm(state, 0, width, 1, modrm);
        record_out[5] = 2;
    } else if (format == 4 || format == 6) {
        reverse_register(record_out, 0, width, opcode_register + ((state.rex & 1) << 3), state.rex, 1);
        record_out[5] = 1;
        if (format == 4) {
            record_out[5] = 2;
        }
    } else if (format == 5) {
        record_out[40] = 5;
        record_out[41] = immediate_bytes * 8;
        var relative: u64 = reverse_field(state, 17, immediate_bytes);
        record_out[42] = reverse_signed(relative, immediate_bytes);
        record_out[46] = immediate_bytes * 8;
        immediate_bytes = 0;
        record_out[5] = 1;
    } else if (format == 7 || format == 14) {
        reverse_rm(state, 0, width, 1, modrm);
        record_out[5] = 1;
    } else if (format == 8) {
        reverse_rm(state, 0, width, 1, modrm);
        record_out[5] = 2;
        if (shift_kind == 0) {
            record_out[56] = 4;
            record_out[57] = 8;
            record_out[58] = 1;
        } else if (shift_kind == 2) {
            reverse_register(record_out, 1, 8, 1, state.rex, 1);
        }
    } else if (format == 9) {
        reverse_register(record_out, 0, width, register_code, state.rex, 1);
        reverse_rm(state, 1, width, 1, modrm);
        record_out[5] = 3;
    } else if (format == 10) {
        reverse_register(record_out, 0, 128, register_code, state.rex, 2);
        reverse_rm(state, 1, width, 2, modrm);
        record_out[5] = 2;
    } else if (format == 11) {
        reverse_rm(state, 0, width, 2, modrm);
        reverse_register(record_out, 1, 128, register_code, state.rex, 2);
        record_out[5] = 2;
    } else if (format == 12) {
        reverse_register(record_out, 0, width, register_code, state.rex, 1);
        reverse_rm(state, 1, source_width, 1, modrm);
        record_out[5] = 2;
    } else if (format == 13) {
        record_out[5] = 1;
    }
    if (immediate_bytes != 0) {
        var operand: u64 = record_out[5] - 1;
        var at: u64 = 40 + operand * 16;
        record_out[at] = 4;
        record_out[at + 1] = width;
        if (format == 8) {
            record_out[at + 1] = 8;
        }
        record_out[at + 2] = reverse_field(state, 17, immediate_bytes);
        record_out[at + 3] = sign_extended;
        record_out[at + 6] = immediate_bytes * 8;
    }
    if (state.status != 0) {
        return state.status;
    }
    record_out[0] = 1;
    record_out[1] = 96;
    record_out[2] = state.position;
    record_out[3] = opcode;
    record_out[4] = condition;
    record_out[6] = flow;
    return 0;
}

export(c) fun whale_wave_reverse_abi() -> u64 {
    return 1;
}

export(c) fun whale_wave_reverse_decode(abi: u64, data: ptr<u8>, length: u64,
    offset: u64, output: ptr<u64>, capacity: u64) -> i32 {
    if (abi != 1) {
        return 6;
    }
    if (data == null || output == null || offset > length || length > 9223372036854775807) {
        return 1;
    }
    if (capacity < 96) {
        return 5;
    }
    var record: array<u64, 96>;
    var i: u64 = 0;
    while (i < 96) {
        record[i] = 0;
        i += 1;
    }
    var state: DecodeState = DecodeState {
        data: data + offset,
        remaining: length - offset,
        position: 0,
        status: 0,
        output: &record[0],
        rex: 0
    };
    var status: i32 = reverse_decode_body(&state);
    if (status != 0) {
        return status;
    }
    i = 0;
    while (i < 96) {
        output[i] = record[i];
        i += 1;
    }
    return 0;
}
