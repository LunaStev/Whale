// SPDX-License-Identifier: MPL-2.0
// Conservative on-demand CFG and xrefs; traversal and block formation live in Wave.
struct CfgState {
    data: ptr<u8>;
    length: u64;
    base: u64;
    overlays: ptr<u64>;
    overlay_count: u64;
    owners: ptr<u64>;
    queue: ptr<u64>;
    stage: ptr<u64>;
    instruction_base: u64;
    block_base: u64;
    edge_base: u64;
    stop_base: u64;
    max_instructions: u64;
    max_blocks: u64;
    max_edges: u64;
    max_stops: u64;
    max_work: u64;
    follow_calls: bool;
    instructions: u64;
    blocks: u64;
    edges: u64;
    stops: u64;
    queued: u64;
    work: u64;
    status: i32;
    target_kind: u64;
    target_value: u64;
    overlay_used: bool;
}

fun cfg_charge(state: ptr<CfgState>, amount: u64) {
    if (state.status != 0) {
        return;
    }
    if (amount > state.max_work - state.work) {
        state.status = 7;
        return;
    }
    state.work += amount;
}

fun cfg_stop(state: ptr<CfgState>, offset: u64, reason: u64, detail: u64) {
    if (state.status != 0) {
        return;
    }
    if (state.stops >= state.max_stops) {
        state.status = 11;
        return;
    }
    cfg_charge(state, 1);
    if (state.status != 0) {
        return;
    }
    var at: u64 = state.stop_base + state.stops * 4;
    state.stage[at] = offset;
    state.stage[at + 1] = reason;
    state.stage[at + 2] = detail;
    state.stage[at + 3] = 0;
    state.stops += 1;
}

fun cfg_edge(state: ptr<CfgState>, from: u64, kind: u64, target_kind: u64, target: u64) {
    if (state.status != 0) {
        return;
    }
    if (state.edges >= state.max_edges) {
        state.status = 10;
        return;
    }
    cfg_charge(state, 1);
    if (state.status != 0) {
        return;
    }
    var at: u64 = state.edge_base + state.edges * 6;
    state.stage[at] = from;
    state.stage[at + 1] = kind;
    state.stage[at + 2] = target_kind;
    state.stage[at + 3] = target;
    state.stage[at + 4] = 0;
    state.stage[at + 5] = 0;
    state.edges += 1;
}

fun cfg_enqueue(state: ptr<CfgState>, address: u64) {
    if (state.status != 0 || address < state.base) {
        return;
    }
    var offset: u64 = address - state.base;
    if (offset >= state.length) {
        return;
    }
    var leader: u64 = 9223372036854775808;
    if ((state.owners[offset] & leader) != 0) {
        return;
    }
    if (state.queued >= state.max_blocks) {
        state.status = 9;
        return;
    }
    cfg_charge(state, 1);
    if (state.status != 0) {
        return;
    }
    state.owners[offset] = state.owners[offset] | leader;
    state.queue[state.queued] = offset;
    state.queued += 1;
}

fun cfg_relative(state: ptr<CfgState>, next: u64, displacement: u64) {
    var target: i128 = (state.base as i128) + (next as i128)
        + ((displacement as i64) as i128);
    state.target_kind = 0;
    state.target_value = 0;
    if (target >= 0 && target <= 18446744073709551615) {
        state.target_kind = 1;
        state.target_value = target as u64;
    }
}

// Sorted, disjoint relocation field records: offset,width,target_kind,target.
// A partial/intersecting field never leaves a placeholder-derived numeric target.
fun cfg_overlay(state: ptr<CfgState>, offset: u64, width: u64) {
    state.overlay_used = false;
    var left: u64 = 0;
    var right: u64 = state.overlay_count;
    while (left < right && state.status == 0) {
        cfg_charge(state, 1);
        var middle: u64 = left + (right - left) / 2;
        if (state.overlays[middle * 4] < offset) {
            left = middle + 1;
        } else {
            right = middle;
        }
    }
    var candidate: u64 = left;
    if (left > 0) {
        var previous: u64 = (left - 1) * 4;
        if (state.overlays[previous] + state.overlays[previous + 1] > offset) {
            candidate = left - 1;
        }
    }
    if (candidate < state.overlay_count) {
        var at: u64 = candidate * 4;
        if (state.overlays[at] < offset + width
            && state.overlays[at] + state.overlays[at + 1] > offset) {
            state.overlay_used = true;
            state.target_kind = 0;
            state.target_value = 0;
            if (state.overlays[at] == offset && state.overlays[at + 1] == width) {
                state.target_kind = state.overlays[at + 2];
                state.target_value = state.overlays[at + 3];
            }
        }
    }
}

fun cfg_references(state: ptr<CfgState>, offset: u64, next: u64, record: ptr<u64>) {
    var operand: u64 = 0;
    while (operand < record[5] && state.status == 0) {
        cfg_charge(state, 1);
        var at: u64 = 40 + operand * 16;
        if (record[at] == 3 && record[14] != 0) {
            var static_address: bool = false;
            if (record[at + 2] == 17) {
                cfg_relative(state, next, record[at + 5]);
                static_address = true;
            } else if (record[at + 2] == 0 && record[at + 3] == 0) {
                state.target_kind = 1;
                state.target_value = record[at + 5];
                static_address = true;
            }
            if (!static_address) {
                state.target_kind = 0;
                state.target_value = 0;
            }
            cfg_overlay(state, offset + record[14] - 1, record[15]);
            if (static_address || state.overlay_used) {
                var kind: u64 = 10;
                if (record[3] == 21) {
                    kind = 11;
                }
                cfg_edge(state, offset, kind, state.target_kind, state.target_value);
            }
        } else if (record[at] == 4 && record[17] != 0) {
            state.target_kind = 0;
            state.target_value = 0;
            cfg_overlay(state, offset + record[17] - 1, record[18]);
            if (state.overlay_used) {
                cfg_edge(state, offset, 11, state.target_kind, state.target_value);
            }
        }
        operand += 1;
    }
}

fun cfg_block(state: ptr<CfgState>, start: u64, end: u64, first: u64, count: u64,
    last: u64) {
    if (state.status != 0 || count == 0) {
        return;
    }
    if (state.blocks >= state.max_blocks) {
        state.status = 9;
        return;
    }
    cfg_charge(state, 1);
    if (state.status != 0) {
        return;
    }
    var at: u64 = state.block_base + state.blocks * 5;
    state.stage[at] = start;
    state.stage[at + 1] = end;
    state.stage[at + 2] = first;
    state.stage[at + 3] = count;
    state.stage[at + 4] = 0;
    state.blocks += 1;
    var record: u64 = state.instruction_base + last * 97;
    if (state.stage[record + 1 + 6] == 0) {
        cfg_edge(state, state.stage[record], 0, 1, state.base + end);
    }
}

fun cfg_run(state: ptr<CfgState>, seeds: ptr<u64>, seed_count: u64) {
    cfg_charge(state, state.length);
    if (state.status != 0) {
        return;
    }
    var i: u64 = 0;
    while (i < state.length) {
        state.owners[i] = 0;
        i += 1;
    }
    i = 0;
    while (i < seed_count && state.status == 0) {
        cfg_enqueue(state, state.base + seeds[i]);
        i += 1;
    }
    var queued: u64 = 0;
    var mask: u64 = 4611686018427387903;
    var leader: u64 = 9223372036854775808;
    while (queued < state.queued && state.status == 0) {
        var cursor: u64 = state.queue[queued];
        queued += 1;
        var first: bool = true;
        while (cursor < state.length && state.status == 0) {
            cfg_charge(state, 1);
            if (state.status != 0) {
                return;
            }
            if (!first && (state.owners[cursor] & leader) != 0) {
                break;
            }
            first = false;
            var owner: u64 = state.owners[cursor] & mask;
            if (owner != 0) {
                var existing: u64 = state.stage[state.instruction_base + (owner - 1) * 97];
                if (existing != cursor) {
                    cfg_stop(state, cursor, 5, existing);
                }
                break;
            }
            if (state.instructions >= state.max_instructions) {
                state.status = 8;
                return;
            }
            var at: u64 = state.instruction_base + state.instructions * 97;
            var record: ptr<u64> = state.stage + at + 1;
            var decoded: i32 = whale_wave_reverse_decode(1, state.data, state.length,
                cursor, record, 96);
            if (decoded != 0) {
                cfg_stop(state, cursor, decoded as u64, 0);
                break;
            }
            var length: u64 = record[2];
            var next: u64 = cursor + length;
            i = cursor;
            var conflict: bool = false;
            while (i < next && state.status == 0) {
                cfg_charge(state, 1);
                owner = state.owners[i] & mask;
                if (owner != 0) {
                    var existing: u64 = state.stage[state.instruction_base + (owner - 1) * 97];
                    cfg_stop(state, cursor, 5, existing);
                    conflict = true;
                    break;
                }
                i += 1;
            }
            if (conflict || state.status != 0) {
                break;
            }
            state.stage[at] = cursor;
            i = cursor;
            while (i < next && state.status == 0) {
                cfg_charge(state, 1);
                state.owners[i] = (state.owners[i] & leader) | (state.instructions + 1);
                i += 1;
            }
            state.instructions += 1;
            cfg_references(state, cursor, next, record);
            var flow: u64 = record[6];
            if (flow == 0) {
                cursor = next;
                if (cursor == state.length) {
                    cfg_stop(state, cursor, 6, 0);
                }
                continue;
            }
            if (flow == 1 || flow == 3 || flow == 5 || flow == 6) {
                cfg_relative(state, next, record[42]);
                cfg_overlay(state, cursor + record[17] - 1, record[18]);
                var kind: u64 = 2;
                if (flow == 1) {
                    kind = 1;
                } else if (flow == 5) {
                    kind = 3;
                } else if (flow == 6) {
                    kind = 5;
                }
                cfg_edge(state, cursor, kind, state.target_kind, state.target_value);
                if (state.target_kind == 1 && (flow != 1 || state.follow_calls)) {
                    cfg_enqueue(state, state.target_value);
                }
                if (state.target_kind == 0 && !state.overlay_used) {
                    cfg_stop(state, cursor, 9, 0);
                }
            } else if (flow == 2 || flow == 4) {
                var kind: u64 = 7;
                if (flow == 4) {
                    kind = 8;
                    cfg_stop(state, cursor, 7, 0);
                }
                cfg_edge(state, cursor, kind, 0, 0);
            } else if (flow == 9) {
                cfg_edge(state, cursor, 9, 0, 0);
                cfg_stop(state, cursor, 8, 0);
            }
            if (flow == 1 || flow == 2 || flow == 5 || flow == 6) {
                var fallthrough: u64 = 0;
                if (flow == 5) {
                    fallthrough = 4;
                } else if (flow == 6) {
                    fallthrough = 6;
                }
                cfg_edge(state, cursor, fallthrough, 1, state.base + next);
                cfg_enqueue(state, state.base + next);
                if (next == state.length) {
                    cfg_stop(state, next, 6, 0);
                }
            }
            break;
        }
    }
    // Address-order block formation splits late/backward leaders without host
    // traversal or invented instructions. Every discovered interval is explicit.
    var cursor: u64 = 0;
    var active: bool = false;
    var block_start: u64 = 0;
    var block_end: u64 = 0;
    var first_instruction: u64 = 0;
    var count: u64 = 0;
    var last: u64 = 0;
    while (cursor < state.length && state.status == 0) {
        cfg_charge(state, 1);
        var owner: u64 = state.owners[cursor] & mask;
        if (owner == 0) {
            if (active) {
                cfg_block(state, block_start, block_end, first_instruction, count, last);
                active = false;
            }
            cursor += 1;
            continue;
        }
        var index: u64 = owner - 1;
        var at: u64 = state.instruction_base + index * 97;
        if (state.stage[at] != cursor) {
            // An instruction interior cannot become a separate block.
            cursor += 1;
            continue;
        }
        if (active && (state.owners[cursor] & leader) != 0) {
            cfg_block(state, block_start, block_end, first_instruction, count, last);
            active = false;
        }
        if (!active) {
            active = true;
            block_start = cursor;
            first_instruction = index;
            count = 0;
        }
        count += 1;
        last = index;
        block_end = cursor + state.stage[at + 1 + 2];
        if (state.stage[at + 1 + 6] != 0) {
            cfg_block(state, block_start, block_end, first_instruction, count, last);
            active = false;
        }
        cursor = block_end;
    }
    if (active && state.status == 0) {
        cfg_block(state, block_start, block_end, first_instruction, count, last);
    }
}

export(c) fun whale_wave_reverse_cfg(abi: u64, data: ptr<u8>, length: u64, base: u64,
    seeds: ptr<u64>, seed_count: u64, overlays: ptr<u64>, overlay_count: u64,
    options: ptr<u64>, options_count: u64, workspace: ptr<u64>, workspace_words: u64,
    output: ptr<u64>, output_words: u64) -> i32 {
    if (abi != 1) {
        return 6;
    }
    if (data == null || options == null || workspace == null || output == null
        || (seed_count != 0 && seeds == null) || (overlay_count != 0 && overlays == null)
        || options_count != 6 || length > 16777216 || base > 18446744073709551615 - length) {
        return 1;
    }
    var max_instructions: u64 = options[0];
    var max_blocks: u64 = options[1];
    var max_edges: u64 = options[2];
    var max_stops: u64 = options[3];
    if (max_instructions > 1000000 || max_blocks > 1000000 || max_edges > 4000000
        || max_stops > 1000000 || seed_count > 1000000 || overlay_count > 1000000
        || options[5] > 1) {
        return 1;
    }
    var block_base: u64 = 16 + max_instructions * 97;
    var edge_base: u64 = block_base + max_blocks * 5;
    var stop_base: u64 = edge_base + max_edges * 6;
    var total_words: u64 = stop_base + max_stops * 4;
    var stage_base: u64 = length + max_blocks;
    if (output_words < total_words || workspace_words < stage_base + total_words) {
        return 5;
    }
    if (seed_count > options[4] || overlay_count > options[4] - seed_count) {
        return 7;
    }
    var i: u64 = 0;
    while (i < seed_count) {
        if (seeds[i] >= length) {
            return 1;
        }
        i += 1;
    }
    var previous_end: u64 = 0;
    i = 0;
    while (i < overlay_count) {
        var at: u64 = i * 4;
        var offset: u64 = overlays[at];
        var width: u64 = overlays[at + 1];
        if (width == 0 || width > 8 || offset > length || width > length - offset
            || offset < previous_end || overlays[at + 2] > 2) {
            return 1;
        }
        previous_end = offset + width;
        i += 1;
    }
    var state: CfgState = CfgState {
        data: data, length: length, base: base, overlays: overlays,
        overlay_count: overlay_count, owners: workspace, queue: workspace + length,
        stage: workspace + stage_base, instruction_base: 16,
        block_base: block_base, edge_base: edge_base, stop_base: stop_base,
        max_instructions: max_instructions, max_blocks: max_blocks,
        max_edges: max_edges, max_stops: max_stops, max_work: options[4],
        follow_calls: options[5] == 1, instructions: 0, blocks: 0, edges: 0,
        stops: 0, queued: 0, work: 0, status: 0, target_kind: 0,
        target_value: 0, overlay_used: false
    };
    cfg_charge(&state, seed_count + overlay_count);
    cfg_run(&state, seeds, seed_count);
    var publish_words: u64 = 16 + state.instructions * 97 + state.blocks * 5
        + state.edges * 6 + state.stops * 4;
    cfg_charge(&state, publish_words);
    if (state.status != 0) {
        return state.status;
    }
    i = 0;
    while (i < 16) {
        state.stage[i] = 0;
        i += 1;
    }
    state.stage[0] = 1;
    state.stage[1] = total_words;
    state.stage[2] = state.instructions;
    state.stage[3] = state.blocks;
    state.stage[4] = state.edges;
    state.stage[5] = state.stops;
    state.stage[6] = state.work;
    state.stage[8] = 16;
    state.stage[9] = block_base;
    state.stage[10] = edge_base;
    state.stage[11] = stop_base;
    i = 0;
    while (i < 16) {
        output[i] = state.stage[i];
        i += 1;
    }
    var group: u64 = 0;
    while (group < 4) {
        var start: u64 = 16;
        var words: u64 = state.instructions * 97;
        if (group == 1) {
            start = block_base;
            words = state.blocks * 5;
        } else if (group == 2) {
            start = edge_base;
            words = state.edges * 6;
        } else if (group == 3) {
            start = stop_base;
            words = state.stops * 4;
        }
        i = 0;
        while (i < words) {
            output[start + i] = state.stage[start + i];
            i += 1;
        }
        group += 1;
    }
    return 0;
}
